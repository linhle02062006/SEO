# ===== Core =====
# PostgreSQL connection string.
#
# ► ĐỂ TRỐNG  -> dùng PGlite local file DB (thư mục ./.pglite). Không cần cài server.
# ► ĐIỀN URL  -> dùng PostgreSQL thật (Supabase / Neon / RDS / Postgres local).
#
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
#
# LƯU Ý QUAN TRỌNG:
#  - Ký tự đặc biệt trong mật khẩu PHẢI được URL-encode
#    (vd: @ -> %40, # -> %23, : -> %3A)
#  - Supabase: dùng "Session pooler" (port 5432) hoặc "Transaction pooler" (port 6543).
#    Transaction pooler cần thêm `?pgbouncer=true`.
#  - Không cần thêm `?sslmode=require` — ứng dụng tự cấu hình SSL đúng cách.
DATABASE_URL=

# Số connection tối đa trong pool (chỉ áp dụng khi dùng PostgreSQL thật).
# Serverless (Vercel) nên để 1-2 để không tràn connection của provider.
DATABASE_POOL_MAX=10

# Public site URL (no trailing slash). Used for sitemap, canonical, OG, schema, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Google Search Console =====
# Paste the "html-tag" verification code, e.g. abc123... (without the meta tags)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ===== Google Analytics 4 =====
# Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ===== Google Tag Manager =====
# Container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# ===== Auth =====
# Secret used to sign session cookies (generate: openssl rand -base64 32)
AUTH_SECRET=

# ===== Admin seed account (used by npm run db:seed) =====
ADMIN_EMAIL=admin@techzone.vn
ADMIN_PASSWORD=Admin@12345

# ===== Email liên hệ (nhận yêu cầu tư vấn từ form) =====
# Email nhận thông báo khi khách gửi form liên hệ.
# Dùng cho: form liên hệ, footer, trang liên hệ, Schema.org.
CONTACT_EMAIL=1350080137@sv.hcmunre.edu.vn
# Bản public (dùng cho client component) — để trống nếu không cần.
NEXT_PUBLIC_CONTACT_EMAIL=

# ===== SMTP (gửi email thật) =====
# BẮT BUỘC cấu hình để form liên hệ gửi được email.
# Nếu thiếu hoặc sai, website hiển thị:
#   "Không thể gửi yêu cầu lúc này. Vui lòng thử lại sau."
# (không báo "gửi thành công" khi email thực sự chưa được gửi).
#
# ► Gmail: bật 2FA rồi tạo "App Password" (mật khẩu 16 ký tự).
#   https://myaccount.google.com/apppasswords
# ► Ví dụ cho Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your.gmail@gmail.com
#   SMTP_PASS=abcd efgh ijkl mnop
#   MAIL_FROM="TechZone <your.gmail@gmail.com>"
#
# ► Outlook/Hotmail: SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587
# ► Yahoo: SMTP_HOST=smtp.mail.yahoo.com, SMTP_PORT=587
#
# KHÔNG commit file .env.local lên Git (đã nằm trong .gitignore).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
