# ===== Core =====
# PostgreSQL connection string.
#
# ► ĐỂ TRỐNG  -> dùng PGlite local file DB (thư mục ./.pglite). Không cần cài server.
# ► ĐIỀN URL  -> dùng PostgreSQL thật (Supabase / Neon / RDS / Postgres local).
#
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE
#
# LƯU Ý QUAN TRỌNG:
#  - Ký tự đặc biệt trong mật khẩu PHẢI được URL-encode
#    (vd: @ -> %40, # -> %23, : -> %3A)
#  - Supabase: dùng "Session pooler" (port 5432) hoặc "Transaction pooler" (port 6543).
#    Transaction pooler cần thêm `?pgbouncer=true`.
#  - Không cần thêm `?sslmode=require` — ứng dụng tự cấu hình SSL đúng cách.
DATABASE_URL=

# Số connection tối đa trong pool (chỉ áp dụng khi dùng PostgreSQL thật).
# Serverless (Vercel) nên để 1-2 để không tràn connection của provider.
DATABASE_POOL_MAX=10

# Public site URL (no trailing slash). Used for sitemap, canonical, OG, schema, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Google Search Console =====
# Paste the "html-tag" verification code, e.g. abc123... (without the meta tags)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ===== Google Analytics 4 =====
# Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ===== Google Tag Manager =====
# Container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# ===== Auth =====
# Secret used to sign session cookies (generate: openssl rand -base64 32)
AUTH_SECRET=

# ===== Admin seed account (used by npm run db:seed) =====
ADMIN_EMAIL=admin@techzone.vn
ADMIN_PASSWORD=Admin@12345
